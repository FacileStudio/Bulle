# Every key Bulle reads. Values live in casier (project bulle, environments dev and prod).
# This file only documents them; `casier run -- ...` injects the real ones, so no .env is needed.

DATABASE_URL=
PORT=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
TEST_DATABASE_URL=

JOURNAL_URL=
JOURNAL_TOKEN=
NTFY_URL=
NTFY_TOKEN=
PUSH_TOPIC_SECRET=
# Native Android notifications: the Firebase service account key, raw JSON or base64.
FCM_SERVICE_ACCOUNT=
# Browser notifications: a VAPID key pair (bunx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@facile.studio

SSO_ONLY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_SUCCESS_URL=
OIDC_CLI_AUDIENCE=
OIDC_MACHINE_AUDIENCE=
OIDC_SCOPE_PREFIX=

SUITE_COURRIER_MCP_URL=
SUITE_COURRIER_MCP_RESOURCE=
SUITE_AGENDA_MCP_URL=
SUITE_AGENDA_MCP_RESOURCE=
SUITE_SONAR_MCP_URL=
SUITE_SONAR_MCP_RESOURCE=
SUITE_OPUS_URL=
SUITE_OPUS_AUDIENCE=
SUITE_SABLIER_URL=
SUITE_SABLIER_AUDIENCE=
BULLE_SABLIER_TIME_TRACKING=true
SUITE_GLOUTON_URL=
SUITE_GLOUTON_AUDIENCE=

# POST /api/ai/decide: name:<sha256 hex of the key> per calling service, comma-separated.
BULLE_AI_CALLERS=
# The decision model. The key is TYPESAFE_API_KEY (OPENROUTER_API_KEY on the decisions endpoint).
TYPESAFE_API_KEY=
JEV_ENDPOINT=
JEV_BASE_URL=
JEV_MODEL=

BULLE_CREDENTIALS_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

BOITE_WORKER_SOCK=
BOITE_WORKER_TOKEN=
BOITE_CONTROL_KEY=
BULLE_BOX_KEY=
BULLE_IDLE_MINUTES=
BULLE_BOX_CPUS=
BULLE_BOX_MEMORY_MB=
BULLE_BOX_DISK_GB=

ANTENNE_INSTANCE=
ANTENNE_APP=
ANTENNE_SECRET=
ANTENNE_INSTANCE_ID=
