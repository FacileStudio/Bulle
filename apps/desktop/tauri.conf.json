{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulle",
  "mainBinaryName": "bulle-desktop",
  "version": "../client/package.json",
  "identifier": "studio.facile.bulle",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../client/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bulle",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://bulle.facile.studio"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Your coding agent, with its own computer",
    "publisher": "Facile",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "studio.facile.bulle"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQ0Q3QTYxMEU4RDBEQTUKUldTbERZME9ZWHJOM015WFVDZ2pNTkdncUQ4ZHRBb0lTckJ1K0hncFJxWHcwNnV0Q3JWSWQyYm4K",
      "endpoints": [
        "https://github.com/FacileStudio/Bulle/releases/latest/download/latest.json"
      ]
    }
  }
}
